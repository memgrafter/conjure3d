+/**
+ * Sort the ids inside each segment of a CSR adjacency list (ascending).
+ * The fill kernels claim slots with atomicAdd, so without this the order inside a segment changes from run to run,
+ * and every float sum over a segment (QEM, collapse costs, vertex normals, chart perimeters) changes in the last bits.
+ *
+ * @param data: the CSR ids, shape (offsets[num_segments])
+ * @param offsets: the segment offsets, shape (num_segments + 1)
+ */
+inline void sort_csr_segments(Buffer<int>& data, const int* offsets, size_t num_segments, Buffer<char>& cub_temp_storage, cudaStream_t stream) {
+    size_t N = data.size;
+    if (N == 0 || num_segments == 0) return;
+    int* sorted;
+    CUDA_CHECK(cudaMalloc(&sorted, N * sizeof(int)));
+    size_t temp_storage_bytes = 0;
+    CUDA_CHECK(cub::DeviceSegmentedSort::SortKeys(
+        nullptr, temp_storage_bytes,
+        data.ptr, sorted, N, num_segments, offsets, offsets + 1, stream
+    ));
+    cub_temp_storage.resize(temp_storage_bytes);
+    CUDA_CHECK(cub::DeviceSegmentedSort::SortKeys(
+        cub_temp_storage.ptr, temp_storage_bytes,
+        data.ptr, sorted, N, num_segments, offsets, offsets + 1, stream
+    ));
+    CUDA_CHECK(cudaMemcpyAsync(data.ptr, sorted, N * sizeof(int), cudaMemcpyDeviceToDevice, stream));
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+    CUDA_CHECK(cudaFree(sorted));
+}
