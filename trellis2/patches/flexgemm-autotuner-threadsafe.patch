+# Local patch (conjure3d patches/flexgemm-autotuner-threadsafe.patch): an autotuner keeps per-call state on the one
+# object every thread shares (TritonPersistentCacheAutotuner.nargs, the tuning caches), so two threads calling FlexGEMM
+# at once could use each other's arguments: a TypeError, or a kernel config chosen for another shape. Every call that
+# reads or writes that state holds one process-wide lock. Reentrant: the split-K autotuners call the Triton ones inside.
+_AUTOTUNE_LOCK = threading.RLock()
+
+
+def _one_thread_at_a_time(fn):
+    @functools.wraps(fn)
+    def locked(*args, **kwargs):
+        with _AUTOTUNE_LOCK:
+            return fn(*args, **kwargs)
+    return locked
+
