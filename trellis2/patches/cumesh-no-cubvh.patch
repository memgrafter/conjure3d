new file mode 100644
index 0000000..af343c2
--- /dev/null
+++ b/cumesh/_cubvh.py
@@ -0,0 +1,9 @@
+"""Stand-in for CuMesh's compiled cubvh module, which this build leaves out: cubvh at CuMesh's pinned commit carries a
+non-commercial NVIDIA licence (LICENSE_NVIDIA). Its source is never downloaded or compiled. The BVH that TRELLIS.2's
+GLB export uses comes from trianglebvh (MIT), which run.py installs into CuMesh before the export."""
+
+
+def __getattr__(name):
+    if name.startswith("__"):
+        raise AttributeError(name)
+    raise RuntimeError(f"cumesh._cubvh.{name}: cubvh is not built here; use trianglebvh (run.py installs it)")
