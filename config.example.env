# Copy to config.env (git-ignored), edit the paths, then `source config.env` before any step.
# Large folders: the TRELLIS.2 venv (~6 GB), its sources (~1.4 GB), the Hugging Face cache (~17 GB for the 3D stage,
# ~16 GB more for the optional image stage) and the local weight copy (13.6 GB).

# 3D stage (trellis2/setup.sh, trellis2/run.py)
export T2_VENV=$HOME/i23d/venv-t2            # built by trellis2/setup.sh env (only from scratch)
export T2_SRC=$HOME/i23d/src                 # pinned clones: TRELLIS.2, CuMesh, FlexGEMM, BiRefNet
export T2_WEIGHTS=$HOME/i23d/weights         # local, SHA-256-checked copy of the weights run.py loads (memory-mapped)
export HF_HOME=$HOME/i23d/hf                 # Hugging Face cache (downloads at pinned revisions)
export CUDA_HOME=/usr/local/cuda             # CUDA toolkit 13.x (nvcc); must match torch's CUDA 13.0 build
# trianglebvh (the GLB export's BVH, MIT): a git URL of its repository (or of a copy, e.g. file:///path/to/trianglebvh).
# setup.sh env installs it at the commit pinned in setup.sh and builds it with cargo (Rust); this is also its default.
export TRIANGLEBVH_GIT=https://github.com/memgrafter/trianglebvh.git
# export CARGO=$HOME/.cargo/bin/cargo        # default: cargo on PATH, then ~/.cargo/bin/cargo
# export TORCH_CUDA_ARCH_LIST="8.6"          # default: the compute capabilities of the visible GPUs
# export MAX_JOBS=2                          # parallel compile jobs for the CUDA extensions (more = more RAM)
# export SETUP_MIN_RAM_MB=3000               # setup.sh stops the build under this much available RAM
# export SETUP_MIN_FREE_GB=20                # setup.sh stops if the venv's disk has less free space
# export T2_WEIGHTS_MIN_FREE_GB=20           # --install-weights stops if the weights disk would keep less free
# export UV=uv                               # path to uv (https://github.com/astral-sh/uv)
export HF_HUB_DISABLE_TELEMETRY=1 PYTHONDONTWRITEBYTECODE=1

# Optional guards (off when unset)
# export GPU_GUARD_EXPECT_POWER_W=275        # stop unless every GPU's power limit is this value (read only)
# export GPU_GUARD_LOCK_DIR=/tmp             # tools/gpu_guard.sh lock files
# export RAM_GUARD_MIN_MB=3000               # tools/ram_guard.sh stops its command under this much available RAM

# Optional image stage (imagegen/)
export IMAGEGEN_VENV=$HOME/i23d/venv-imagegen
export IMAGEGEN_HOME=$HOME/i23d/imagegen     # queue/, out/<round>/, reference images
# export IMAGEGEN_MIN_RAM_MIB=3072

# Optional render and web export tools
# export BLENDER=blender BASISU=basisu BUN=bun
